{
    "name": "sinclear/beyond-api",
    "description": "Sinclear Beyond API v2",
    "type": "project",
    "require": {
        "php": "^8.4.1",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1",
        "guzzlehttp/guzzle": "^8.3",
        "symfony/mailer": "^8.1",
        "vlucas/phpdotenv": "^5.7",
        "ramsey/uuid": "^4.9",
        "monolog/monolog": "^3.12",
        "minishlink/web-push": "^11.0",
        "sabre/dav": "^4.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "Sinclear\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sinclear\\Api\\Tests\\": "tests/"
        }
    }
}
